{
  "name": "socprint-ui-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Go-based NUS SoC print CLI with an archived Node UI reference",
  "scripts": {
    "start": "go run ./cmd/socprint",
    "prototype": "node bin/socprint.mjs --demo",
    "check": "node --check cmd/socprint-macos/ui/app.js && node --check cmd/socprint-macos/ui/model.js",
    "test": "node --test tests/ui.test.mjs tests/site.test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
